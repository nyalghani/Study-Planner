# A course is a str (Ends-in 3 Nat)

try:
    with open("courses.txt", "r") as file:
        classes = file.read().splitlines()
except FileNotFoundError:
    classes = []
    
#course_in_file: Course -> Bool
#Determines wheter a course is already in the text file
def course_in_text_file(course):
    course_in_file = False
            
    with open("courses.txt", "r") as file:
        for line in file:
            if line.strip() == course.strip():
                course_in_file = True
                
    return course_in_file

#course_in_text_file_name: Course -> Course
#Recursivly determines if a course is in a text file and renames it until it is in the file
def course_in_text_file_name(course):
    if not course_in_text_file(course):
        print("Course Does Not Exist")
                
        course_2 = input("What course? ")
        return course_in_text_file_name(course_2)
    else:
        return course


#assignment_in_text_file: Str -> Bool
#Determines if an assignment is in the text file
def assignment_in_text_file(assignment):
    assignment_in_file = False
    
    with open("courses.txt", "r") as file:
        for line in file:
            if line.strip().lstrip() == assignment.strip():
                assignment_in_file = True
            
    return assignment_in_file

#assignment_in_text_name: Str -> Str
#Recursivly determines if an assignment is in a text file and renames it until it is in the file
def assignment_in_text_file_name(assignment):
    if not assignment_in_text_file(assignment):
        print("Assignment Does Not Exist")
        assignment_2 = input("What Assignment? ")
        
        return assignment_in_text_file_name(assignment_2)
    else:
        return assignment
    

