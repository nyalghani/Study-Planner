def test_set_deadline_with_invalid_date_then_cancel(mocker):
    assignment = study_tracker.Assignment("A08", deadline=date(2026, 11, 16))
    mocker.patch("builtins.input", side_effect=["29/02/2026", ""])

    result = study_tracker.set_deadline(assignment)

    assert result is None
    assert assignment.deadline == date(2026, 11, 16)


def test_manage_assignments_with_upcoming_deadlines(mocker):
    class FixedDate(date):
        @classmethod
        def today(cls):
            return cls(2026, 11, 16)

    course = study_tracker.Course("CS 135")
    later = study_tracker.Assignment("A10", deadline=FixedDate(2026, 11, 20))
    today = study_tracker.Assignment("A08", deadline=FixedDate(2026, 11, 16))
    past = study_tracker.Assignment("A07", deadline=FixedDate(2026, 11, 15))
    invalid = study_tracker.Assignment("A09", deadline="31/11/2026")
    no_deadline = study_tracker.Assignment("A11")
    completed = study_tracker.Assignment("A12", deadline=FixedDate(2026, 11, 17), completed=True)
    course.assignments = [later, past, invalid, no_deadline, completed, today]

    mocker.patch("study_tracker.date", FixedDate)
    mocker.patch("builtins.input", return_value="4")
    show_assignments = mocker.patch("study_tracker.show_assignments")

    study_tracker.manage_assignments([course])

    show_assignments.assert_called_once_with([(course, today), (course, later)])
